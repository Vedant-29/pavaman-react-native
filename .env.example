# Copy this file to .env and fill in real values.
# .env is gitignored.

# Supabase project — Auth + Postgres backend
# https://app.supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps Android SDK key (read by app.json at build time)
# https://console.cloud.google.com → APIs & Services → Credentials
# Restrict by Android package name + SHA-1 fingerprint before going live.
GOOGLE_MAPS_ANDROID_API_KEY=
